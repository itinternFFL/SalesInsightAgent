# Copy this to /etc/sales-agent/backend.env on the server (not committed to
# the repo - it's server-specific config, referenced by
# deploy/sales-agent-backend.service via EnvironmentFile=).

# The real Vercel frontend URL(s), comma-separated, no spaces, no trailing slash.
# Include both the production domain and the *.vercel.app preview domain if
# you want preview deploys to be able to reach the backend too.
ALLOWED_ORIGINS=https://your-app.vercel.app

# Enables the cross-origin cookie settings the session needs once frontend
# and backend are on different domains - see SETUP.md.
APP_ENV=production

# Microsoft SSO - see SETUP.md for where to find each value.
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=your-client-secret-value
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_REDIRECT_URI=https://api.yourdomain.com/auth/callback
FRONTEND_URL=https://your-app.vercel.app

# Random string signing the session cookie - generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
# Use a DIFFERENT value than local dev, and never commit the real one.
SESSION_SECRET_KEY=change-me-to-a-random-value

# Email/password sign-in (an alternative to Microsoft SSO, not a
# replacement) - comma-separated list of domains allowed to self-register.
ALLOWED_EMAIL_DOMAIN=faujifoods.com
