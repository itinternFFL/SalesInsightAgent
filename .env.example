# Copy this file to .env for local development (gitignored - never commit
# real secrets). See SETUP.md for exactly where to find each Microsoft
# value and how to register the app.

# From the Entra ID app registration - Overview page.
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=your-client-secret-value
MS_TENANT_ID=00000000-0000-0000-0000-000000000000

# Must exactly match a redirect URI registered on the app (Authentication
# page). Use the localhost value below for local dev.
MS_REDIRECT_URI=http://localhost:8001/auth/callback

# Where the backend sends the browser after login/logout.
FRONTEND_URL=http://localhost:5173

# Random string used to sign the session cookie - any long random value.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-to-a-random-value

# "development" (default) uses same-site cookies for the local Vite proxy
# setup. Set to "production" on the real server - see SETUP.md.
APP_ENV=development

# Email/password sign-in (an alternative to Microsoft SSO, not a
# replacement). Comma-separated list of domains allowed to self-register -
# e.g. faujifoods.com or faujifoods.com,fauji.com.pk. Leave unset to
# disable self-registration entirely (login-password still works for any
# existing accounts, but /auth/register always refuses).
ALLOWED_EMAIL_DOMAIN=faujifoods.com
